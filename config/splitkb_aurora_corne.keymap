#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&led_strip { chain-length = <27>; };

&nice_view_spi { cs-gpios = <&gpio1 1 GPIO_ACTIVE_HIGH>; };

&sl { release-after-ms = <2000>; };

/ {
    behaviors {
        contrl_tap: contrl_tap {
            compatible = "zmk,behavior-tap-dance";
            label = "CONTRL_TAP";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings =
                <&kp LEFT_CONTROL>,
                <&kp LEFT_ALT>,
                <&kp LA(LEFT_CONTROL)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        tomain {
            bindings = <&to 0>;
            key-positions = <38 39>;
        };

        tonumbers {
            bindings = <&to 1>;
            key-positions = <39 37>;
        };

        toF {
            bindings = <&to 3>;
            key-positions = <39 36>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        main {
            bindings = <
&kp ESCAPE  &kp SQT   &kp COMMA  &kp DOT  &kp P           &kp Y    &kp F      &kp G      &kp C          &kp R  &kp L  &kp FSLH
&kp TAB     &kp A     &kp O      &kp E    &kp U           &kp I    &kp D      &kp H      &kp T          &kp N  &kp S  &kp MINUS
&kp BSLH    &kp SEMI  &kp Q      &kp J    &kp K           &kp X    &kp B      &kp M      &kp W          &kp V  &kp Z  &kp EQUAL
                                 &mo 2    &kp LEFT_SHIFT  &mo 1    &kp ENTER  &kp SPACE  &kp BACKSPACE
            >;

            label = "Main US";
        };

        numbers {
            bindings = <
&kp ESC   &kp N1  &kp N2  &kp N3         &kp N4        &kp N5       &kp N6          &kp N7    &kp N8     &kp N9     &kp N0             &kp LEFT_WIN
&kp LGUI  &none   &none   &kp C_AC_HOME  &kp UP_ARROW  &kp END      &kp N4          &kp UP    &kp N6     &kp MINUS  &bt BT_NXT         &trans
&kp RGUI  &none   &none   &kp LEFT       &kp DOWN      &kp RIGHT    &kp LEFT_ARROW  &kp DOWN  &kp RIGHT  &kp BSLH   &ext_power EP_TOG  &trans
                          &none          &trans        &none        &trans          &trans    &trans
            >;

            label = "Num US";
        };

        symbols {
            bindings = <
&kp ESC  &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(N5)       &kp LS(NUMBER_6)  &kp LS(N7)        &kp LS(N8)     &kp LS(N9)        &kp LS(NUMBER_0)  &to 4
&kp F1   &kp F2            &kp F3            &kp F4            &kp F5            &kp F6           &kp F7            &kp F8            &kp F9         &kp F10           &kp F11           &kp F12
&trans   &trans            &none             &kp LC(LEFT)      &kp LC(DOWN)      &kp LC(RIGHT)    &kp LS(LEFT)      &kp LS(UP_ARROW)  &kp LS(RIGHT)  &kp LS(UP_ARROW)  &none             &to 4
                                             &none             &trans            &none            &none             &kp LS(N0)        &trans
            >;

            label = "Sym US";
        };

        f_layer {
            bindings = <
&kp C_AL_TASK_MANAGER  &none  &none  &none   &none          &none     &kp F7  &kp F8  &kp F9  &kp F10   &kp F11   &kp F12
&trans                 &none  &none  &none   &kp PAGE_DOWN  &trans    &kp F4  &kp F5  &kp F6  &kp RBKT  &kp BSLH  &trans
&trans                 &none  &none  &none   &kp PAGE_DOWN  &trans    &kp F1  &kp F2  &kp F3  &kp RBRC  &kp PIPE  &kp INSERT
                                     &trans  &trans         &none     &none   &trans  &trans
            >;

            label = "F | US";
        };

        settings {
            bindings = <
&trans  &ext_power EP_TOG  &trans           &trans           &trans                            &trans                            &trans  &trans  &trans  &trans  &trans  &to 3
&trans  &bl BL_TOG         &bl BL_CYCLE     &trans           &trans                            &trans                            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &rgb_ug RGB_TOG    &rgb_ug RGB_EFF  &rgb_ug RGB_HUI  &rgb_ug RGB_COLOR_HSB(29,100,49)  &rgb_ug RGB_COLOR_HSB(0,0,100)    &trans  &trans  &trans  &trans  &trans  &trans
                                            &trans           &trans                            &to 0                             &trans  &trans  &trans
            >;

            label = "Settings";
        };
    };
};
